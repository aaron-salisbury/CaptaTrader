<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Integrations tier of application.</Description>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Let our unit tests access and verify the behavior of internal classes, methods, and properties. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>CaptaTrader.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="MarketData/Replay/Data/*.csv" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CaptaTrader.Business\CaptaTrader.Business.csproj" />
  </ItemGroup>

</Project>
